+func TestUpdateRelayRouteRulesCreatesPairedAddressFamilyRoutes(t *testing.T) {
+	dbDir := t.TempDir()
+	t.Setenv("SUI_DB_FOLDER", dbDir)
+	if err := database.InitDB(filepath.Join(dbDir, "relay-paired-rules.db")); err != nil {
+		t.Fatal(err)
+	}
