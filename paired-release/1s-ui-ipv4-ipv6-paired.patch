+		DateTime: now.Unix(), Actor: actor, Key: "relay", Action: "rotate", Obj: mustJSON(change),
+	}).Error; err != nil {
+		return nil, err
+	}
+	if err := tx.Commit().Error; err != nil {
+		return nil, err
+	}
