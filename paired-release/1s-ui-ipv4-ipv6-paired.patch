+func discoverRelayIPv6Summary(excluded map[string]bool, limit int) ([]RelayIPv6, int, error) {
+	all, err := discoverRelayIPv6()
+	if err != nil {
+		return nil, 0, err
+	}
+	result, total := summarizeRelayIPv6(all, excluded, limit)
+	return result, total, nil
