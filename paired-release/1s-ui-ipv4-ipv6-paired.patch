+func relayPairedDNSResolverRequired(rules []interface{}) bool {
+	for _, raw := range rules {
+		entry, ok := raw.(map[string]interface{})
+		if ok && fmt.Sprint(entry["action"]) == "resolve" && fmt.Sprint(entry["server"]) == relayPairedDNSResolverTag {
