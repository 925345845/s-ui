+func relayRuleHasCIDR(rule map[string]interface{}, expected string) bool {
+	switch values := rule["ip_cidr"].(type) {
+	case []interface{}:
+		for _, value := range values {
+			if fmt.Sprint(value) == expected {
+				return true
+			}
+		}
+	case []string:
+		for _, value := range values {
+			if value == expected {
+				return true
+			}
+		}
+	}
+	return false
+}
