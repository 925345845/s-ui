[Unit]
Description=s-ui Service
Documentation=https://github.com/Hhz0823/1s-ui
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/usr/local/s-ui/
ExecStart=/usr/local/s-ui/sui
Restart=on-failure
RestartSec=10s

# Prefer killing the panel under memory pressure instead of SSH/sshd.
OOMScoreAdjust=500
OOMPolicy=continue

# Do NOT set MemoryMax here — hard caps can thrash small VPS and look like a power-off.
LimitNOFILE=1048576
TimeoutStartSec=60
TimeoutStopSec=30
Nice=5

[Install]
WantedBy=multi-user.target
